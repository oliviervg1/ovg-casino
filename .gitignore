# cxas-agent-foundry's optional pointer file for multi-project workspaces.
# We're a single project (gecx-config.json lives at repo root) and don't
# use this; gitignored so a stray creation by `setup.sh` doesn't litter.
.active-project

# `cxas pull` mirrors prod evals into cxas_app/Casino_Concierge/evaluations/
# as JSON-per-conversation. The repo's source of truth is evals/goldens/*.yaml
# (pushed via `cxas push-eval`); committing the pulled JSON would duplicate
# every Golden in two places and create push/pull drift. Ignored to keep
# evals/goldens/ as the single source of truth. See "### Evals" in CLAUDE.md.
cxas_app/Casino_Concierge/evaluations/
